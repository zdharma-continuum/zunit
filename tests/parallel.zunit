#!/usr/bin/env zunit

@setup {
  project_root="${testdir:A:h}"
  zunit_bin="$project_root/bin/zunit"
  fixture="$project_root/tests/_support/parallel"
  slow_fixture="$project_root/tests/_support/parallel-slow"

  # The progress bar is only drawn when stderr is a terminal, so
  # these runs happen on a pseudo terminal. zpty is used rather than
  # script(1), whose options differ between platforms. The second
  # argument is passed to zpty, so that a test which cares about the
  # terminal mode can ask for one which echoes its input
  run_on_tty() {
    local chunk
    zmodload zsh/zpty 2>/dev/null || skip 'zsh/zpty is not available'

    zpty ${2:-} zunit_tty "$1"
    tty_output=''
    while zpty -r zunit_tty chunk; do tty_output+="$chunk"; done
    zpty -d zunit_tty
  }

  # Collect each version of the bar which was drawn to the terminal
  # during the last run_on_tty. A redraw starts by returning to the
  # first column, so the output is split on carriage returns and
  # newlines, and the escape sequences are stripped so that what is
  # left is what the terminal actually displayed
  progress_bars() {
    local -a segments
    setopt local_options extended_glob

    segments=(${(ps:\r:)${tty_output//$'\n'/$'\r'}})
    segments=(${segments//$'\e['[0-9?]#[a-zA-Z]/})
    bars=(${(M)segments:#*passed*})
  }

  # Matches a bar such as '[####----] 6/15  4 passed  1 failed'
  progress_bar='[0-9]+/[0-9]+  [0-9]+ passed  [0-9]+ failed'
}

# Outputs are compared via cksum because they are multi-line strings
# full of ANSI escapes, which the same_as assertion would otherwise
# treat as a glob pattern. Before comparing, a known marker is
# asserted on the raw serial output so the parity check cannot pass
# vacuously on two identical failure messages
#
# The group count banner is filtered out alongside the timing line: it
# is the one line a parallel run prints which a serial run has no
# equivalent for, and it has tests of its own below

@test 'parallel output matches serial output for multiple files' {
  serial_out=$(cd "$fixture" && zsh "$zunit_bin" run tests 2>&1 | grep -v -e 'ran in' -e 'group[s]* across')
  parallel_sum=$(cd "$fixture" && zsh "$zunit_bin" run --parallel tests 2>&1 | grep -v -e 'ran in' -e 'group[s]* across' | cksum)

  assert "$serial_out" matches 'a first passes'
  assert "$serial_out" matches 'single eight passes'
  assert "$(print -r -- "$serial_out" | cksum)" same_as "$parallel_sum"
}

@test 'parallel output matches serial output for a single file' {
  serial_out=$(cd "$fixture" && zsh "$zunit_bin" run tests/single-mixed.zunit 2>&1 | grep -v -e 'ran in' -e 'group[s]* across')
  parallel_sum=$(cd "$fixture" && zsh "$zunit_bin" run --parallel tests/single-mixed.zunit 2>&1 | grep -v -e 'ran in' -e 'group[s]* across' | cksum)

  assert "$serial_out" matches 'single eight passes'
  assert "$(print -r -- "$serial_out" | cksum)" same_as "$parallel_sum"
}

@test 'sliced output matches serial output for a single file' {
  serial_out=$(cd "$fixture" && zsh "$zunit_bin" run tests/single-mixed.zunit 2>&1 | grep -v -e 'ran in' -e 'group[s]* across')
  sliced_sum=$(cd "$fixture" && zsh "$zunit_bin" run --parallel --slice tests/single-mixed.zunit 2>&1 | grep -v -e 'ran in' -e 'group[s]* across' | cksum)

  assert "$serial_out" matches 'single eight passes'
  assert "$(print -r -- "$serial_out" | cksum)" same_as "$sliced_sum"
}

@test 'a file which shares state between tests survives --parallel' {
  # The tests in a file run in declaration order and share what they
  # leave on disk, so a file is one unit of work. Without that, the
  # second test here reads a marker the first has not written yet
  rm -f "$fixture/tests-ordered/marker-ordered"

  run zsh -c "cd '$fixture' && zsh '$zunit_bin' run --parallel tests-ordered/ordered.zunit"

  assert $state equals 0
}

@test '--slice splits a single file across workers' {
  integer cores
  cores=$(nproc 2>/dev/null) \
    || cores=$(getconf _NPROCESSORS_ONLN 2>/dev/null) \
    || cores=$(sysctl -n hw.ncpu 2>/dev/null) \
    || cores=2
  (( cores >= 2 )) || skip 'needs at least two cores'

  # The same fixture, sliced: the two tests now start together, so
  # the reader loses its ordering guarantee and the run fails. This
  # is the behaviour --slice opts in to, and the reason it is not
  # the default
  rm -f "$fixture/tests-ordered/marker-ordered"

  run zsh -c "cd '$fixture' && zsh '$zunit_bin' run --parallel --slice tests-ordered/ordered.zunit"

  assert $state equals 1
}

@test '--slice implies --parallel' {
  integer cores
  cores=$(nproc 2>/dev/null) \
    || cores=$(getconf _NPROCESSORS_ONLN 2>/dev/null) \
    || cores=$(sysctl -n hw.ncpu 2>/dev/null) \
    || cores=2
  (( cores >= 2 )) || skip 'needs at least two cores'

  # Slicing has nothing to split a file across without workers, so
  # the flag turns parallel mode on rather than doing neither. The
  # ordered fixture is the probe: it only breaks when it is actually
  # split, so a run which fails here is a run which was sliced
  rm -f "$fixture/tests-ordered/marker-ordered"

  run zsh -c "cd '$fixture' && zsh '$zunit_bin' run --slice tests-ordered/ordered.zunit"

  assert $state equals 1
}

@test 'a parallel run says how many groups it was split into' {
  # Four files in the fixture, and a file is one unit of work, so the
  # group count does not move with the number of cores the run finds
  run zsh -c "cd '$fixture' && zsh '$zunit_bin' run --parallel tests"

  assert "$output" matches '4 parallel groups across [0-9]+ workers?'
}

@test 'a sliced run counts slices rather than files' {
  # The slice count is bounded by the cores available, so only the
  # shape of the line can be asserted - the number belongs to the machine
  run zsh -c "cd '$fixture' && zsh '$zunit_bin' run --parallel --slice tests/single-mixed.zunit"

  assert "$output" matches '[0-9]+ slice groups? across [0-9]+ workers?'
}

@test 'a run split into one group is not counted in the plural' {
  # c-pass.zunit holds a single test, and a file is never split into
  # more slices than it has tests, so this run has exactly one group
  # wherever it is run
  run zsh -c "cd '$fixture' && zsh '$zunit_bin' run --parallel --slice tests/c-pass.zunit"

  assert "$output" matches '1 slice group across'
}

@test 'the group count is left out of TAP output' {
  # TAP is machine readable, so the line is suppressed rather than
  # dressed up as a diagnostic
  run zsh -c "cd '$fixture' && zsh '$zunit_bin' run --tap --parallel tests"

  assert "$output" does_not_match '(parallel|slice) group'
}

@test 'the group count is printed once' {
  # Printed by the runner before the workers start, not by each of them
  run zsh -c "cd '$fixture' && zsh '$zunit_bin' run --parallel tests | grep -c 'parallel groups'"

  assert "$output" same_as '1'
}

@test 'parallel TAP output matches serial TAP output' {
  serial_out=$(cd "$fixture" && zsh "$zunit_bin" run --tap tests 2>&1 | grep -v 'ran in')
  parallel_sum=$(cd "$fixture" && zsh "$zunit_bin" run --tap --parallel tests 2>&1 | grep -v 'ran in' | cksum)

  assert "$serial_out" matches 'ok 1 - a first passes'
  assert "$serial_out" matches '1\.\.[0-9]+'
  assert "$(print -r -- "$serial_out" | cksum)" same_as "$parallel_sum"
}

@test 'parallel run of passing files exits 0' {
  run zsh "$zunit_bin" run --parallel "$fixture/tests/a-pass.zunit" "$fixture/tests/c-pass.zunit"

  assert $state equals 0
}

@test 'parallel run with failures exits 1' {
  run zsh "$zunit_bin" run --parallel "$fixture/tests/b-mixed.zunit"

  assert $state equals 1
}

@test 'parallel fail-fast stops the other workers' {
  rm -f "$fixture/tests-failfast/marker-created"

  run zsh -c "cd '$fixture' && zsh '$zunit_bin' run --fail-fast --parallel tests-failfast"

  assert $state equals 1
  run test -e "$fixture/tests-failfast/marker-created"
  assert $state equals 1
}

@test 'parallel run reports a crashed worker as an error' {
  # Run from inside the fixture so no .zunit.yml time limit applies -
  # with a time limit the test runs one process deeper and the killer
  # would murder the async wrapper instead of the worker
  run zsh -c "cd '$fixture' && zsh '$zunit_bin' run --parallel tests-crash/killer.zunit"

  assert $state equals 1
  assert "$output" matches 'Parallel worker exited unexpectedly'

  # The killed test never reports a result of its own - the worker
  # died before it could write one
  assert "$output" matches 'Passed.*: 0/1'
}

@test 'parallel can be enabled from .zunit.yml' {
  run zsh -c "cd '$project_root/tests/_support/parallel-config' && zsh '$zunit_bin' run"

  assert $state equals 0
  assert "$output" matches 'config enabled parallel run passes'
}

@test 'parallel run draws a progress bar on a terminal' {
  run_on_tty "cd '$fixture' && zsh '$zunit_bin' run --parallel tests"

  assert "$tty_output" matches "$progress_bar"

  # The denominator counts every test in the fixture directory
  assert "$tty_output" matches '/15  [0-9]+ passed'

  # The bar is erased, and the results still print in full
  assert "$tty_output" matches 'a first passes'
  assert "$tty_output" matches 'ZUnit Results'
}

@test 'parallel run progress bar can be disabled with --no-progress' {
  run_on_tty "cd '$fixture' && zsh '$zunit_bin' run --parallel --no-progress tests"

  assert "$tty_output" does_not_match "$progress_bar"
  assert "$tty_output" matches 'ZUnit Results'
}

@test 'parallel progress bar follows a terminal resize' {
  # zpty gives its terminal no window size, so the run starts out
  # drawing to the fallback width. Narrowing the terminal while the
  # run is in progress has to shrink the bar - a bar which is wider
  # than the terminal wraps, and a wrapped line cannot be erased, so
  # every redraw after it leaves a copy of itself on the screen
  run_on_tty "cd '$slow_fixture' && { sleep 1; stty columns 30 <&2 } & zsh '$zunit_bin' run --parallel tests"

  progress_bars
  assert ${#bars} is_greater_than 0

  integer narrowest=999
  for bar in $bars; do
    (( ${#bar} < narrowest )) && narrowest=${#bar}
  done

  assert $narrowest is_less_than 30
}

@test 'parallel progress bar never fills the last column' {
  # No window size is reported by zpty, so the width comes from
  # $COLUMNS here
  COLUMNS=40 run_on_tty "cd '$fixture' && zsh '$zunit_bin' run --parallel tests"

  progress_bars
  assert ${#bars} is_greater_than 0

  for bar in $bars; do
    assert ${#bar} is_less_than 40
  done
}

@test 'parallel progress bar is not redrawn when nothing has changed' {
  run_on_tty "cd '$fixture' && zsh '$zunit_bin' run --parallel tests"

  progress_bars
  assert ${#bars} is_greater_than 0

  integer i
  for (( i = 2; i <= ${#bars}; i++ )); do
    assert "${bars[$i]}" different_to "${bars[$i - 1]}"
  done
}

@test 'terminal echo is restored after a parallel run' {
  # The bar turns echo off, so that a newline typed during the run
  # cannot scroll it up the screen. zpty only echoes input when it is
  # asked to, so the -e option is what gives this test something to
  # check. The fixture contains failing tests, and without the
  # `|| true` that status would stop the terminal from being examined
  run_on_tty "cd '$fixture' && { zsh '$zunit_bin' run --parallel tests >/dev/null 2>&1 || true }; stty -a <&2 | tr ' ' '\n' | grep -x -e echo -e '-echo'" -e

  # The terminal ends every line it writes with a carriage return
  assert "${tty_output//[$'\r\n']/}" same_as 'echo'
}

@test 'parallel run draws no progress bar when output is piped' {
  # The fixture contains failing tests, so the runner exits non-zero.
  # Without the `|| true` that status would end the test body early
  piped_out=$(cd "$fixture" && zsh "$zunit_bin" run --parallel tests 2>&1 || true)

  assert "$piped_out" does_not_match "$progress_bar"
  assert "$piped_out" matches 'ZUnit Results'
}

@test 'parallel from .zunit.yml actually runs workers' {
  # The crash message is only ever printed by the parallel runner, so
  # it proves the config key really activated parallel mode
  run zsh -c "cd '$project_root/tests/_support/parallel-config' && zsh '$zunit_bin' run '$fixture/tests-crash/killer.zunit'"

  assert $state equals 1
  assert "$output" matches 'Parallel worker exited unexpectedly'
}
