#!/usr/bin/env zunit

@test 'beta one sees the bootstrap environment' {
  assert "$bootstrap_pid" is_not_empty
  assert "$bootstrap_scoped_var" same_as 'present'
}

@test 'beta two sees the bootstrap environment' {
  assert "$bootstrap_pid" is_not_empty
  assert "$bootstrap_scoped_var" same_as 'present'
}
